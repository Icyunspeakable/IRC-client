{
  "name": "frostchat",
  "version": "0.1.0",
  "description": "Terminal chat with local jsonl storage",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "frostchat": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/index.ts --cli",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/tcp": "^11.0.20",
    "@types/blessed": "^0.1.27",
    "blessed": "^0.1.81",
    "libp2p": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
